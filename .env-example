# ==============================================================================
# Clareia — Variáveis de Ambiente (EXEMPLO FICTÍCIO)
# Copie este arquivo para `.env` na raiz do repositório e preencha valores reais.
# O arquivo `.env` está listado no `.gitignore` e NUNCA deve ser versionado.
# ==============================================================================

# --- Backend (Spring Boot / Java 21) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_TIMEZONE=America/Sao_Paulo

# --- Banco de Dados (PostgreSQL 16) ---
POSTGRES_DB=clareia_exemplo
POSTGRES_USER=usuario_ficticio
POSTGRES_PASSWORD=senha_ficticia_trocar_antes_de_usar
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/clareia_exemplo
DB_USERNAME=usuario_ficticio
DB_PASSWORD=senha_ficticia_trocar_antes_de_usar

# --- Segurança & JWT ---
# Em produção, gere uma chave aleatória segura com >= 32 bytes (ex.: openssl rand -base64 48)
JWT_SECRET=chave-ficticia-de-exemplo-com-mais-de-32-caracteres-nao-usar-em-producao
JWT_ISSUER=clareia-api-exemplo
JWT_EXPIRATION_SECONDS=28800

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Ambiente Demo ---
# Em produção, mantenha ambos como false.
CLAREIA_DEMO_ENABLED=true
CLAREIA_DEMO_SEED_ON_STARTUP=true
CLAREIA_DEMO_DEFAULT_PASSWORD=senha_demo_ficticia

# --- Frontend (Vite) ---
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_API_URL=/api/v1
